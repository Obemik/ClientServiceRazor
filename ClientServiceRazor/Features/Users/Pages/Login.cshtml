@page
@model ClientServiceRazor.Features.Users.Pages.Login
@{
    Layout = "/Pages/Shared/_Layout.cshtml";
    ViewData["Title"] = "Авторизація";
}
<h2>Авторизація</h2>
<form method="post">
    @Html.AntiForgeryToken()
    <div>
        <label>Логін:</label>
        <input asp-for="Input.Login"/>
        <span asp-validation-for="Input.Login" class="text-danger"></span>
    </div>
    <div>
        <label>Пароль:</label>
        <input asp-for="Input.Password" type="password"/>
        <span asp-validation-for="Input.Password" class="text-danger"></span>
    </div>
    <button type="submit">Увійти</button>
</form>
@if (!string.IsNullOrEmpty(Model.Message))
{
    <p>@Model.Message</p>
}